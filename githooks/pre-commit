#!/usr/bin/env bash
# Blocks a commit if data/processed/accessibility_by_postal_code.csv (or any
# CSV given as an arg) has malformed postal_code values - e.g. a leading zero
# silently dropped by pandas int64 inference. See scripts/validate_postal_codes.py.
#
# Enable once per clone with:
#   git config core.hooksPath githooks
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

target="data/processed/accessibility_by_postal_code.csv"

# Capture staged file names to a variable first (not piped straight into
# grep) so a SIGPIPE from grep -q exiting early can't make the pipeline's
# exit status look like "not staged" under `set -o pipefail`.
staged_files="$(git diff --cached --name-only)"
if ! grep -qxF "$target" <<< "$staged_files"; then
    exit 0
fi

python="python3"
if [ -x .venv/bin/python ]; then
    python=".venv/bin/python"
fi

# Validate the staged blob, not the working-tree copy - they can diverge
# (e.g. further edits after `git add` without re-staging), and the hook
# should judge what's actually about to be committed.
if ! git show ":${target}" | "$python" scripts/validate_postal_codes.py -; then
    echo "pre-commit hook: aborting commit due to postal_code validation failure." >&2
    exit 1
fi
