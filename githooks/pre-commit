#!/usr/bin/env bash
# Blocks a commit if data/processed/accessibility_by_postal_code.csv (or any
# CSV given as an arg) has malformed postal_code values - e.g. a leading zero
# silently dropped by pandas int64 inference. See scripts/validate_postal_codes.py.
#
# Enable once per clone with:
#   git config core.hooksPath githooks
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

target="data/processed/accessibility_by_postal_code.csv"

# Query the diff status for just this path instead of listing all staged
# files and grepping - simpler, and avoids two problems: no pipe into grep
# to trip on SIGPIPE under `pipefail`, and no ambiguity when the file is
# being deleted (status "D"): `git show :path` fails for a deleted path, so
# skip validation instead of letting that failure crash the hook.
status="$(git diff --cached --name-status -- "$target")"
if [ -z "$status" ] || [[ "$status" == D* ]]; then
    exit 0
fi

python="python3"
if [ -x .venv/bin/python ]; then
    python=".venv/bin/python"
fi

# Validate the staged blob, not the working-tree copy - they can diverge
# (e.g. further edits after `git add` without re-staging), and the hook
# should judge what's actually about to be committed.
if ! git show ":${target}" | "$python" scripts/validate_postal_codes.py -; then
    echo "pre-commit hook: aborting commit due to postal_code validation failure." >&2
    exit 1
fi
